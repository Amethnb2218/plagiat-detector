# ===== CONFIGURATION PRINCIPALE =====
# Copier ce fichier en .env et adapter les valeurs

DEBUG=True
SECRET_KEY=votre-cle-secrete-a-changer-en-production

# Base de données PostgreSQL (utilisé par Docker)
DB_NAME=plagiat_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis (broker Celery)
REDIS_URL=redis://redis:6379/0

# Serveur
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# ===== MODE DEVELOPPEMENT SANS DOCKER =====
# Décommenter ces lignes pour tester sans Docker (mode dégradé, pas d'IA)
# USE_SQLITE=True
# CELERY_EAGER=True
# DB_HOST=localhost
